Task 10: Naive Pattern Searching – GeeksforGeeks
Problem
Find all positions where a pattern occurs in a text.
Java Solution
public class NaivePatternSearch {

    static void search(String text, String pattern) {

        int n = text.length();
        int m = pattern.length();

        for (int i = 0; i <= n - m; i++) {

            int j;

            for (j = 0; j < m; j++) {

                if (text.charAt(i + j)
                        != pattern.charAt(j)) {

                    break;
                }
            }

            if (j == m) {
                System.out.println(
                    "Pattern found at index " + i
                );
            }
        }
    }

    public static void main(String[] args) {

        String text = "AABAACAADAABAABA";
        String pattern = "AABA";

        search(text, pattern);
    }
}
Output
Pattern found at index 0
Pattern found at index 9
Pattern found at index 12
