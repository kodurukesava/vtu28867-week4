            if (pq.size() > k)
                pq.poll();
        }

        List<String> result = new ArrayList<>();

        while (!pq.isEmpty())
            result.add(pq.poll());

        Collections.reverse(result);

        for (String word : result)
            System.out.println(word);
    }
}
